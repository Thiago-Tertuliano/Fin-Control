{
  "name": "fin-control",
  "version": "0.1.0",
  "private": true,
  "description": "Gestão financeira pessoal — gastos, renda e investimentos",
  "author": "Axellion",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "powershell -NoProfile -Command \"$env:npm_config_cache='D:\\npm-cache'; $env:TEMP='D:\\temp'; $env:TMP='D:\\temp'; $env:NEXT_TELEMETRY_DISABLED='1'; next dev\"",
    "dev:plain": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:clear": "node scripts/clear-data.js",
    "desktop:prepare": "next build && node scripts/prepare-standalone.mjs && node scripts/bundle-node.mjs",
    "desktop:pack": "npm run desktop:prepare && electron-builder --win --config electron-builder.json",
    "desktop:dir": "npm run desktop:prepare && electron-builder --win --dir --config electron-builder.json"
  },
  "dependencies": {
    "@edusites/bancos-brasil": "^1.2.0",
    "@icons-pack/react-simple-icons": "^13.11.1",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
